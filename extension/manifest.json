{
  "manifest_version": 3,
  "name": "Maps Data Collector",
  "version": "0.3.0",
  "description": "Collects publicly visible Google Maps and Justdial listing information into your lead database.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Maps Data Collector"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.in/maps/*"
      ],
      "js": [
        "src/content/mapsTap.iife.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.co.in/maps/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.justdial.com/*"
      ],
      "js": [
        "src/content/justdialTap.iife.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.justdial.com/*"
      ],
      "js": [
        "src/content/justdial/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  }
}
