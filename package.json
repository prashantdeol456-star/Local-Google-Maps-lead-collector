{
  "name": "google-maps-lead-platform",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "extension",
    "linkedin-extension",
    "linkedin-messenger",
    "meta-helper",
    "admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:extension": "npm run dev -w extension",
    "build:extension": "npm run build -w extension",
    "dev:linkedin": "npm run dev -w linkedin-extension",
    "build:linkedin": "npm run build -w linkedin-extension",
    "dev:messenger": "npm run dev -w linkedin-messenger",
    "build:messenger": "npm run build -w linkedin-messenger",
    "dev:meta": "npm run dev -w meta-helper",
    "build:meta": "npm run build -w meta-helper",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:admin": "npm run dev -w admin",
    "build:admin": "npm run build -w admin",
    "guide:build": "node scripts/guide/build.mjs",
    "build:extensions": "npm run build -w extension && npm run build -w linkedin-extension && npm run pack:extensions -w backend"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
