PORT=3000
HOST=127.0.0.1
# sqlite (local, default) or postgresql (server). Generate the Prisma client for it: npm run db:generate -w backend
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:../data/app.db"
# PostgreSQL example: DATABASE_URL="postgresql://leads:password@localhost:5432/leads?connection_limit=10"
# Behind a reverse proxy (Caddy/nginx) set to 1 so rate limits see real client IPs. false = direct.
TRUST_PROXY=false
# fatal | error | warn | info | debug
# LOG_LEVEL=info
# Long random string; used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS=24
# Chrome extension login tokens; 0 = never expire (they can still be revoked)
API_TOKEN_TTL_DAYS=90
# Extra browser origins allowed to call the API, comma-separated (e.g. a hosted admin panel).
# The Chrome extension does not need an entry.
CORS_ORIGINS=""
# IANA time zone for "today" in stats (and later, campaign sending windows)
APP_TIMEZONE="Asia/Kolkata"
# Initial admin, created on first start if no admin exists
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Public https address of this backend (e.g. https://leads.example.com). Used in email
# unsubscribe links; required before a campaign can start with a real email provider.
PUBLIC_BASE_URL=""

# ---- WhatsApp ----
# log  = development: nothing is sent (default)
# meta = Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_PROVIDER="log"
META_WA_ACCESS_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
# Webhooks: app secret (App settings → Basic) verifies signatures; verify token is any string you choose
META_WA_APP_SECRET=""
META_WA_VERIFY_TOKEN=""
META_WA_API_VERSION="v26.0"
# messages = Cloud API; marketing_messages = Marketing Messages API (falls back to Cloud API)
META_WA_SEND_ENDPOINT="messages"

# ---- Email ----
# Click tracking: email links go through PUBLIC_BASE_URL/t/c/... (true/false)
EMAIL_TRACK_CLICKS="true"
# log    = development: nothing is sent, messages are only recorded (default)
# resend = Resend API (delivery/open/click/bounce tracking via webhooks)
# smtp   = any SMTP server (Gmail, Zoho, Outlook...; no tracking events)
EMAIL_PROVIDER="log"
# Sender. Must be on a domain verified with your provider, e.g. "Acme Sales <sales@acme.in>"
EMAIL_FROM=""
# Optional: where replies go
EMAIL_REPLY_TO=""

# Resend (EMAIL_PROVIDER=resend): API key from resend.com/api-keys,
# webhook signing secret (whsec_...) from the webhook's page in the Resend dashboard
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""

# SMTP (EMAIL_PROVIDER=smtp). Port 465 = TLS, 587 = STARTTLS.
# For Gmail use an App Password (not your normal password).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# ---- Social accounts (Admin → Social Accounts) ----
# Connect with each platform's own login (OAuth). Never put Facebook/Instagram/LinkedIn passwords here.
# Facebook Pages + Instagram Business/Creator: developers.facebook.com → your app → App settings → Basic
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v26.0"
# Optional: permissions to ask (comma-separated); default covers posts, Page messages, Instagram DMs/comments
# META_SCOPES=""
# LinkedIn: linkedin.com/developers → your app → Auth (products: Sign In with LinkedIn using OpenID Connect, Share on LinkedIn)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# LINKEDIN_SCOPES="openid profile email w_member_social"
# Address your browser uses for this backend; register <this>/api/oauth/callback/meta and /linkedin
# as redirect URIs. Defaults to PUBLIC_BASE_URL, else http://localhost:PORT
SOCIAL_REDIRECT_BASE_URL=""

# ---- AI Inbox (Admin → AI Inbox) ----
# Claude writes replies to Telegram, Facebook, Instagram and LinkedIn chats. Uses ANTHROPIC_API_KEY
# (below). Turn replies on and write what the AI knows in Admin → AI Inbox → AI instructions.
# INBOX_AI_MODEL="claude-opus-5-5"
# low | medium | high (more thinking = better answers, slower and costlier)
# INBOX_AI_EFFORT="medium"
# Telegram bot token from @BotFather (/newbot). Empty = Telegram off.
TELEGRAM_BOT_TOKEN=""
# How often Facebook Page and Instagram inboxes are checked (seconds)
# INBOX_POLL_SECONDS=60

# ---- Optional AI navigation (Phase 16) ----
# Off by default. When on, and "AI assist" is ticked in the extension, the collector asks the AI
# for ONE next step only when it cannot find the Maps results list (e.g. after a layout change).
# The key stays here on the backend; the extension never sees it. Every step is logged on the job.
# AI is never used for duplicates, normalization, storage or exports.
AI_PROVIDER=off
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# AI requests allowed per collection job
AI_MAX_STEPS_PER_JOB=12
