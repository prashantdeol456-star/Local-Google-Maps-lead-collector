// GENERATED from prisma/schema.prisma by `npm run db:pg:schema`. Do not edit by hand.

// The one schema for both databases. This file is SQLite (local); prisma/postgres/schema.prisma
// is generated from it for PostgreSQL (npm run db:pg:schema) and has its own migrations.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  pending
  running
  paused
  completed
  failed
  stopped
}

enum ItemResult {
  new
  duplicate
  error
}

enum Channel {
  email
  whatsapp
}

/**
 * Templates exist for more channels than the campaigns that send them.
 */
enum TemplateChannel {
  email
  whatsapp
  sms
  linkedin
  instagram
}

enum CampaignStatus {
  draft
  running
  paused
  completed
  stopped
}

enum AttemptStatus {
  queued
  sending
  sent
  delivered
  failed
  skipped
  cancelled
}

enum LogLevel {
  info
  success
  warning
  error
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  /**
   * Login id chosen at registration (lowercase); email works too
   */
  username     String?         @unique
  phone        String?
  name         String?
  passwordHash String
  /**
   * super_admin | customer
   */
  role         String          @default("customer")
  /**
   * pending (registered, waiting for approval) | active | disabled
   */
  status       String          @default("pending")
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  apiTokens    ApiToken[]
  jobs         CollectionJob[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Bearer tokens for the Chrome extension (and future API clients). Only the hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  /**
   * full | read (read: GET requests only; for integrations such as n8n)
   */
  scope      String    @default("full")
  createdAt  DateTime  @default(now())
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id            String  @id @default(cuid())
  /**
   * User whose collection this lead belongs to (see database/ownerScope.ts)
   */
  ownerId       String?
  placeId       String?
  name          String
  category      String?
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  rating        Float?
  reviewCount   Int?
  mapsUrl       String?
  searchKeyword String?
  source        String  @default("google_maps")

  normalizedName    String
  normalizedPhone   String?
  normalizedWebsite String?
  normalizedAddress String?
  dedupeKey         String

  firstSeenAt    DateTime                     @default(now())
  lastSeenAt     DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  jobItems       JobItem[]
  attempts       ContactAttempt[]
  emailEvents    EmailEvent[]
  whatsappEvents WhatsAppEvent[]
  preference     LeadCommunicationPreference?

  @@unique([ownerId, placeId])
  @@unique([ownerId, dedupeKey])
  @@index([normalizedPhone])
  @@index([normalizedWebsite])
  @@index([normalizedName])
  @@index([city])
  @@index([category])
  @@index([searchKeyword])
  @@index([createdAt])
  @@index([ownerId])
}

model CollectionJob {
  id               String     @id @default(cuid())
  ownerId          String?
  searchKeyword    String
  location         String?
  maxRecords       Int?
  status           JobStatus  @default(pending)
  statusReason     String?
  totalFound       Int        @default(0)
  newRecords       Int        @default(0)
  duplicateRecords Int        @default(0)
  errorRecords     Int        @default(0)
  // Multi-keyword search queue: jobs sharing a queueId run in `position` order (Phase 6).
  queueId          String?
  position         Int?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdById      String?
  createdBy        AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items            JobItem[]
  logs             AgentLog[]

  @@index([status])
  @@index([createdAt])
  @@index([queueId, position])
  @@index([ownerId])
}

model JobItem {
  id        String        @id @default(cuid())
  jobId     String
  clientKey String
  result    ItemResult
  matchedBy String?
  leadId    String?
  error     String?
  createdAt DateTime      @default(now())
  job       CollectionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([jobId, clientKey])
  @@index([leadId])
}

model AgentLog {
  id        String         @id @default(cuid())
  jobId     String?
  action    String
  status    LogLevel
  message   String?
  createdAt DateTime       @default(now())
  job       CollectionJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

// ---- Outreach (Phase 10+) ----

/**
 * Per-lead consent. No row = defaults (email allowed, WhatsApp needs recorded opt-in).
 */
model LeadCommunicationPreference {
  leadId              String    @id
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId             String?
  emailAllowed        Boolean   @default(true)
  whatsappAllowed     Boolean   @default(false)
  whatsappOptInAt     DateTime?
  whatsappOptInSource String?
  optedOut            Boolean   @default(false)
  optOutReason        String?
  optedOutAt          DateTime?
  updatedAt           DateTime  @updatedAt
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model MessageTemplate {
  id                 String             @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId            String?
  channel            TemplateChannel
  name               String
  /**
   * Email only
   */
  subject            String?
  /**
   * Plain text with {{variables}}; HTML is generated safely from it.
   */
  body               String
  /**
   * WhatsApp: the template as approved by Meta (name = template name, body uses lead variables).
   */
  provider           String?
  language           String?
  /**
   * marketing | utility | authentication
   */
  category           String?
  externalTemplateId String?
  /**
   * pending | approved | rejected | paused | disabled (set by the admin from WhatsApp Manager)
   */
  approvalStatus     String?
  /**
   * positional ({{1}}, {{2}}) or named ({{name}}) parameters
   */
  paramFormat        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  campaigns          Campaign[]
  linkedinCampaigns  LinkedInCampaign[]

  @@index([channel])
  @@index([ownerId])
}

model Campaign {
  id           String           @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId      String?
  channel      Channel
  name         String
  templateId   String
  provider     String
  status       CampaignStatus   @default(draft)
  statusReason String?
  /**
   * Fixed gap between two sends (seconds).
   */
  intervalSec  Int              @default(180)
  dailyLimit   Int              @default(50)
  /**
   * Sending window, local time "HH:MM" in timeZone.
   */
  windowStart  String           @default("10:00")
  windowEnd    String           @default("18:00")
  timeZone     String           @default("Asia/Kolkata")
  startAt      DateTime?
  lastSentAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  template     MessageTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  attempts     ContactAttempt[]

  @@index([status])
  @@index([ownerId])
}

/**
 * One message to one lead: the send queue and the communication history.
 */
model ContactAttempt {
  id                String          @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId           String?
  leadId            String
  campaignId        String?
  channel           Channel
  provider          String
  status            AttemptStatus   @default(queued)
  templateId        String?
  toAddress         String
  renderedSubject   String?
  renderedBody      String?
  externalMessageId String?
  /**
   * Retries after temporary provider errors.
   */
  tries             Int             @default(0)
  nextTryAt         DateTime?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  /**
   * First time each tracking event was seen (details in EmailEvent).
   */
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  repliedAt         DateTime?
  /**
   * WhatsApp: shown in an open chat (blue ticks; the recipient can turn read receipts off).
   */
  readAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign          Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  emailEvents       EmailEvent[]
  whatsappEvents    WhatsAppEvent[]
  trackedLinks      TrackedLink[]

  @@unique([campaignId, leadId])
  @@unique([campaignId, toAddress])
  @@index([campaignId, status, createdAt])
  @@index([leadId, createdAt])
  @@index([externalMessageId])
  @@index([status, sentAt])
  @@index([ownerId])
}

enum EmailEventType {
  sent
  delivered
  delivery_delayed
  opened
  clicked
  bounced
  complained
  failed
  replied
  unsubscribed
}

/**
 * Tracking events: provider webhooks, our click redirects, logged replies, unsubscribes.
 */
model EmailEvent {
  id              String          @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId         String?
  type            EmailEventType
  attemptId       String?
  leadId          String?
  /**
   * Id from the provider; a webhook delivered twice is stored once.
   */
  providerEventId String?         @unique
  /**
   * resend, click_tracking, admin, unsubscribe_link
   */
  source          String
  /**
   * JSON: clicked link, bounce reason, reply text, user agent
   */
  metadata        String?
  occurredAt      DateTime
  createdAt       DateTime        @default(now())
  attempt         ContactAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([type, occurredAt])
  @@index([ownerId])
}

/**
 * A link inside a sent email, redirected through /t/c/:id so clicks can be counted.
 */
model TrackedLink {
  id        String         @id
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId   String?
  attemptId String
  url       String
  createdAt DateTime       @default(now())
  attempt   ContactAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([ownerId])
}

enum WhatsAppEventType {
  sent
  delivered
  read
  failed
  /**
   * A message the business received (a reply, or a message from an unknown number).
   */
  received
  /**
   * Opt-in withdrawn: STOP reply, "stop marketing" in WhatsApp, or error 131050
   */
  opted_out
  /**
   * The user resumed marketing messages in WhatsApp (does NOT restore the opt-in by itself).
   */
  marketing_resumed
}

/**
 * WhatsApp webhook events and received messages, linked to the lead and the message when known.
 */
model WhatsAppEvent {
  id                String            @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId           String?
  type              WhatsAppEventType
  attemptId         String?
  leadId            String?
  /**
   * Other party, E.164 with "+"
   */
  phone             String?
  /**
   * Id from the provider; a webhook delivered twice is stored once.
   */
  providerEventId   String?           @unique
  /**
   * WhatsApp message id (wamid) of the message this event is about
   */
  externalMessageId String?
  /**
   * meta, keyword, admin
   */
  provider          String
  /**
   * Text of a received message
   */
  text              String?
  /**
   * JSON: error details, profile name, message type
   */
  metadata          String?
  occurredAt        DateTime
  createdAt         DateTime          @default(now())
  attempt           ContactAttempt?   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lead              Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([attemptId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([type, occurredAt])
  @@index([ownerId])
}

/**
 * Addresses that must not receive marketing on a channel (unsubscribed, STOP, spam report,
 * do-not-contact). Keyed by address, not lead, so it still applies if the lead is deleted
 * and later collected again from Google Maps.
 */
model Suppression {
  id        String   @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId   String?
  channel   Channel
  /**
   * email: lowercase address · whatsapp: E.164 phone with "+"
   */
  address   String
  reason    String
  /**
   * unsubscribe_link, spam_complaint, stop_reply, whatsapp_stop, whatsapp_error, do_not_contact, admin, import
   */
  source    String
  /**
   * Lead it was recorded for (plain id: the entry must outlive the lead).
   */
  leadId    String?
  createdAt DateTime @default(now())

  @@unique([ownerId, channel, address])
  @@index([leadId])
  @@index([createdAt])
  @@index([ownerId])
}

// ---- Integrations (Phase 17): outgoing webhooks, e.g. to n8n ----

model WebhookEndpoint {
  id         String            @id @default(cuid())
  name       String
  url        String
  /**
   * Signing secret, AES-256-GCM encrypted with a key derived from SESSION_SECRET
   */
  secretEnc  String
  /**
   * Last 4 characters, to recognise it in the UI
   */
  secretHint String
  /**
   * JSON array of event types
   */
  events     String
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
}

/**
 * One event for one endpoint: the send queue (with retries) and the delivery log.
 */
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  /**
   * Stable id of the event, e.g. "lead.created:<leadId>": an event is queued once per endpoint
   */
  eventId        String
  event          String
  payload        String
  /**
   * pending | delivered | failed
   */
  status         String          @default("pending")
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  responseStatus Int?
  lastError      String?
  createdAt      DateTime        @default(now())
  deliveredAt    DateTime?
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// ---- LinkedIn Helper: profiles saved by hand from the LinkedIn Helper extension or a
// LinkedIn "Connections.csv" export. Kept apart from Google Maps leads. ----

model LinkedInLead {
  id             String   @id @default(cuid())
  /**
   * https://www.linkedin.com/in/<slug> (lowercase slug, no query)
   */
  ownerId        String?
  profileUrl     String
  name           String
  /**
   * Headline / designation
   */
  headline       String?
  company        String?
  location       String?
  /**
   * JSON array of lowercase email addresses
   */
  emails         String   @default("[]")
  /**
   * JSON array of phone numbers as shown
   */
  phones         String   @default("[]")
  /**
   * JSON array of { url, label }
   */
  websites       String   @default("[]")
  /**
   * JSON array of instant-messenger entries, e.g. "name (Skype)"
   */
  ims            String   @default("[]")
  /**
   * JSON array of { title, company, employmentType, dates, location }
   */
  experience     String   @default("[]")
  /**
   * JSON array of { school, degree, dates }
   */
  education      String   @default("[]")
  birthday       String?
  address        String?
  connectedSince String?
  notes          String?
  /**
   * Free label to group profiles, e.g. the search you did ("HR Lucknow")
   */
  tag            String?
  /**
   * extension | csv | admin
   */
  source         String
  hasEmail       Boolean  @default(false)
  hasPhone       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ownerId, profileUrl])
  @@index([createdAt])
  @@index([ownerId])
  @@index([company])
  @@index([tag])
}

// ---- Contacts uploaded from a sheet (name, LinkedIn URL, phone, email, designation, company)
// and LinkedIn message campaigns sent through the LinkedIn Messenger extension. ----

model OutreachContact {
  id           String            @id @default(cuid())
  /**
   * User this belongs to (see database/ownerScope.ts)
   */
  ownerId      String?
  name         String
  /**
   * Canonical https://www.linkedin.com/in/<slug>; the key used to merge re-uploads
   */
  linkedinUrl  String?
  /**
   * Canonical https://www.instagram.com/<username>/
   */
  instagramUrl String?
  /**
   * Lowercase
   */
  email        String?
  phone        String?
  designation  String?
  company      String?
  /**
   * Name given to the uploaded sheet, to group contacts ("HR Lucknow Oct")
   */
  listName     String?
  /**
   * sheet | admin
   */
  source       String            @default("sheet")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     LinkedInMessage[]

  @@unique([ownerId, linkedinUrl])
  @@unique([ownerId, instagramUrl])
  @@index([listName])
  @@index([email])
  @@index([createdAt])
  @@index([ownerId])
}

model LinkedInCampaign {
  id           String            @id @default(cuid())
  /**
   * linkedin | instagram: which extension sends it (LinkedIn Messenger or Meta Helper)
   */
  platform     String            @default("linkedin")
  name         String
  templateId   String
  status       CampaignStatus    @default(draft)
  statusReason String?
  /**
   * assisted: the extension types the message and you click Send · auto: it also clicks Send
   */
  mode         String            @default("assisted")
  /**
   * Fixed gap between two messages (seconds).
   */
  intervalSec  Int               @default(300)
  dailyLimit   Int               @default(20)
  windowStart  String            @default("10:00")
  windowEnd    String            @default("18:00")
  timeZone     String            @default("Asia/Kolkata")
  startAt      DateTime?
  lastSentAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  template     MessageTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  messages     LinkedInMessage[]

  @@index([status])
  @@index([platform, status])
}

/**
 * One LinkedIn message to one contact: the extension's work queue and the send log.
 */
model LinkedInMessage {
  id           String           @id @default(cuid())
  campaignId   String
  contactId    String?
  profileUrl   String
  contactName  String
  renderedBody String
  /**
   * queued → sending (handed to the extension) → sent | failed | skipped; cancelled on stop
   */
  status       AttemptStatus    @default(queued)
  error        String?
  claimedAt    DateTime?
  sentAt       DateTime?
  failedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campaign     LinkedInCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      OutreachContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, profileUrl])
  @@index([campaignId, status, createdAt])
  @@index([status, updatedAt])
  @@index([contactId])
}

// ---- Social accounts connected with the platforms' own login (OAuth). No passwords. ----

model SocialAccount {
  id             String    @id @default(cuid())
  /**
   * facebook_page | instagram | linkedin
   */
  platform       String
  /**
   * Page id, Instagram account id, or LinkedIn member id ("sub")
   */
  externalId     String
  name           String
  username       String?
  pictureUrl     String?
  /**
   * Access token, AES-256-GCM encrypted (SecretBox "social-tokens"); never sent to the admin panel
   */
  tokenEnc       String
  /**
   * null = does not expire (Facebook Page tokens from a long-lived login)
   */
  tokenExpiresAt DateTime?
  /**
   * JSON array of granted permissions
   */
  scopes         String    @default("[]")
  /**
   * connected | expired | error
   */
  status         String    @default("connected")
  lastError      String?
  /**
   * JSON: extras, e.g. the Facebook Page an Instagram account is linked to
   */
  meta           String    @default("{}")
  connectedById  String?
  lastCheckedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([platform, externalId])
  @@index([platform])
}

// ---- AI Inbox: chats from Telegram (bot), Facebook Pages, Instagram and LinkedIn, with
// AI-written replies (sent automatically when safe, otherwise kept as drafts). ----

/**
 * One chat with one person on one platform.
 */
model InboxConversation {
  id                  String         @id @default(cuid())
  /**
   * telegram | facebook | instagram | linkedin
   */
  platform            String
  /**
   * SocialAccount id (Facebook/Instagram), "bot" (Telegram), "extension" (LinkedIn)
   */
  accountKey          String
  /**
   * The platform's id for this chat (Telegram chat id, Messenger/Instagram conversation id, LinkedIn thread id)
   */
  externalThreadId    String
  /**
   * The other person's id for sending (Telegram chat id, PSID, IGSID, LinkedIn profile URL)
   */
  participantId       String?
  participantName     String
  participantUsername String?
  /**
   * smart | auto | draft | off; null = the platform's default from the AI settings
   */
  replyMode           String?
  /**
   * needs_reply | draft_ready | replied | handled | no_reply
   */
  status              String         @default("needs_reply")
  lastIntent          String?
  /**
   * The AI's short summary of who this is and what they want
   */
  summary             String?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  lastMessageAt       DateTime
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  messages            InboxMessage[]
  drafts              InboxDraft[]

  @@unique([platform, accountKey, externalThreadId])
  @@index([status, lastMessageAt])
  @@index([platform, lastMessageAt])
}

model InboxMessage {
  id             String            @id @default(cuid())
  conversationId String
  /**
   * in = from the other person · out = from you (or the AI)
   */
  direction      String
  /**
   * The platform's message id (dedupe); LinkedIn: a hash of the message
   */
  externalId     String?
  text           String
  /**
   * customer | ai_auto | ai_approved | admin | elsewhere (sent outside this panel)
   */
  author         String
  sentAt         DateTime
  createdAt      DateTime          @default(now())
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

/**
 * A reply the AI wrote.
 */
model InboxDraft {
  id             String            @id @default(cuid())
  conversationId String
  /**
   * pending | sending | sent | dismissed | failed | superseded
   */
  status         String            @default("pending")
  text           String
  intent         String?
  summary        String?
  language       String?
  confidence     Float?
  needsHuman     Boolean           @default(false)
  /**
   * Why it was held for approval or sent automatically
   */
  decision       String?
  /**
   * The inbound message it answers
   */
  forMessageId   String?
  model          String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

/**
 * What the AI knows and may do (one row, id "default").
 */
model AiAssistantSettings {
  id                   String   @id @default("default")
  /**
   * Master switch: off = nothing is drafted or sent
   */
  enabled              Boolean  @default(false)
  /**
   * Who you are, what you sell, prices, hours, location, links
   */
  businessProfile      String   @default("")
  /**
   * Questions and answers the AI can use as they are
   */
  faqs                 String   @default("")
  /**
   * Tone, languages (e.g. reply in the customer's language: Hindi, English or Hinglish), length, signature
   */
  style                String   @default("")
  /**
   * Topics the AI must never answer itself (it leaves them for you)
   */
  neverSay             String   @default("")
  /**
   * JSON: platform → smart | auto | draft | off
   */
  modes                String   @default("{\"telegram\":\"smart\",\"facebook\":\"smart\",\"instagram\":\"smart\",\"linkedin\":\"draft\"}")
  /**
   * Smart mode sends on its own only at or above this confidence (0–1)
   */
  minConfidence        Float    @default(0.8)
  /**
   * Most automatic replies per chat per day
   */
  maxAutoPerChatPerDay Int      @default(5)
  /**
   * Telegram getUpdates offset, so a restart does not re-read old messages
   */
  telegramOffset       Int      @default(0)
  /**
   * anthropic | gemini
   */
  aiProvider           String   @default("anthropic")
  /**
   * Model id; empty = the provider's default
   */
  aiModel              String   @default("")
  /**
   * low | medium | high (thinking effort)
   */
  aiEffort             String   @default("medium")
  /**
   * Keys entered in the admin panel, AES-256-GCM encrypted (SecretBox "inbox-secrets"); .env is the fallback
   */
  anthropicKeyEnc      String?
  anthropicKeyHint     String?
  geminiKeyEnc         String?
  geminiKeyHint        String?
  telegramTokenEnc     String?
  telegramTokenHint    String?
  updatedAt            DateTime @updatedAt
}

// ---- Social leads: Instagram profiles, Facebook Pages, groups and profiles saved by the Meta
// Helper extension from keyword searches the user runs (public details only; no member lists). ----

model SocialLead {
  id           String   @id @default(cuid())
  /**
   * instagram | facebook
   */
  platform     String
  /**
   * profile | page | group
   */
  kind         String
  /**
   * Canonical link (unique)
   */
  url          String   @unique
  /**
   * Instagram username or Facebook vanity name, when known
   */
  handle       String?
  name         String
  /**
   * Bio, Page category line or group description, as shown
   */
  bio          String?
  category     String?
  followers    Int?
  /**
   * Followers/members as shown, e.g. "21.7K followers"
   */
  audienceText String?
  /**
   * Groups: public | private
   */
  privacy      String?
  email        String?
  phone        String?
  website      String?
  location     String?
  /**
   * The search keyword it was found with
   */
  keyword      String?
  tag          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform, kind])
  @@index([keyword])
  @@index([createdAt])
}

/** A customer's own email and WhatsApp sender (phase C). Super admins use the .env senders. */
model SenderSettings {
  /** The user (AdminUser id) */
  ownerId         String   @id
  /** EmailConfig as JSON, encrypted with SecretBox("sender-secrets") */
  emailConfig     String?
  /** Non-secret part for display: JSON { provider, from } */
  emailSummary    String?
  /** WhatsAppConfig as JSON, encrypted */
  whatsappConfig  String?
  /** JSON { provider, phoneNumberId } */
  whatsappSummary String?
  /** Random part of this user's webhook URLs (/api/webhooks/u/<token>/…) */
  webhookToken    String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
