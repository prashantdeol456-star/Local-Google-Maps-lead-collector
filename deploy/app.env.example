# App settings for the server (docker compose reads this as deploy/app.env).
# Database, HOST, PORT, TRUST_PROXY and PUBLIC_BASE_URL are set in docker-compose.yml.
# The backend refuses to start in production with example secrets or http URLs.

# Long random string, at least 32 characters (e.g. openssl rand -base64 48).
# Keep it the same when moving from your laptop: webhook secrets are encrypted with it.
SESSION_SECRET=
SESSION_TTL_HOURS=24
API_TOKEN_TTL_DAYS=90
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# First admin, created on the first start only. Use a strong password (12+ characters), then
# remove ADMIN_PASSWORD from this file after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Extra https origins for the API (normally empty: the admin panel is served by the app).
CORS_ORIGINS=

# ---- Email (see backend/.env.example for every option) ----
EMAIL_PROVIDER=log
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_TRACK_CLICKS=true

# ---- WhatsApp ----
WHATSAPP_PROVIDER=log
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=

# ---- Optional AI navigation ----
AI_PROVIDER=off
ANTHROPIC_API_KEY=
